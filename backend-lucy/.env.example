# Supabase (obligatoire)
# Récupérer URL et clés dans Supabase : Project Settings → API
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# LLM Chat (GPT‑5 mini) — requis pour l’endpoint /chat réel
# Créer une clé auprès de ton fournisseur (OpenAI ou autre)
LUCY_LLM_API_KEY=
LUCY_LLM_MODEL=gpt-5-mini-2025-08-07
# Effort de raisonnement. Le raisonnement est facturé en output et pèse >90 % du coût
# par tour. `low` = même adhérence aux règles que le défaut du modèle, pour ~60 % de
# coût output en moins et ~2× moins de latence (mesuré sur 50 réponses par palier).
# Valeurs : default | none | minimal | low | medium | high
# `default` omet le paramètre et rend la main au modèle (retour arrière sans code).
# ⚠️ Les valeurs acceptées dépendent du modèle : gpt-5-mini refuse `none`,
#    gpt-5.6-luna refuse `minimal`. Une valeur refusée casse tous les appels /chat.
LUCY_LLM_REASONING_EFFORT=low

# LLM Snapshot (GPT‑5 nano) — modèle utilisé pour l’extraction JSON des snapshots mémoire
# Si absent, la clé chat est utilisée pour le snapshot aussi
LUCY_SNAPSHOT_LLM_MODEL=gpt-5-nano-2025-08-07
# LUCY_SNAPSHOT_LLM_API_KEY=   # optionnel si même fournisseur que le chat

# RevenueCat — vérification serveur de l'abonnement (porte du chat, 5 échanges offerts
# puis abonnement). Clé SECRÈTE de l'API REST : dashboard RevenueCat → Project settings
# → API keys → « + New » : nom libre, VERSION V1 (le serveur appelle l'API v1).
# Commence par sk_, affichée une seule fois. JAMAIS la clé publique du SDK.
# Sans elle, toute personne qui a épuisé ses échanges offerts reçoit 503, abonné compris.
REVENUECAT_SECRET_API_KEY=
# Identifiant d'entitlement, au caractère près celui du dashboard (défaut : Lucy Premium)
# REVENUECAT_ENTITLEMENT_ID=Lucy Premium

# Optionnel
LUCY_ENV=dev
PORT=4000

# Postgres URI — requis pour le worker (snapshots 5.4–5.5). Voir README.
DATABASE_URL=

PG_SSL_CA_PATH=